# Authoring sources and locked dependencies use Git LFS in the private repository.
# Keep the current source chain only; old candidates remain in the verified local backup.
models/**/*.blend
models/**/*.blend[0-9]
models/**/*.glb
models/**/*.zip
!models/ori/3/ori_rigged.glb
models/**/*.crdownload
models/**/*.part

